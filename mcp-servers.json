{
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.tavily.com/mcp/?tavilyApiKey=YOUR_TAVILY_API_KEY_HERE"
      ]
    },
    "sumble": {
      "type": "http",
      "url": "https://mcp.sumble.com"
    },
    "zoominfo": {
      "type": "http",
      "url": "https://mcp.zoominfo.com/mcp"
    },
    "commonroom": {
      "type": "http",
      "url": "https://mcp.commonroom.io/mcp"
    }
  }
}
